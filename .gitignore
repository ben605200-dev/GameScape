# =====================================================================
# GameScape .gitignore
# Principle: secrets, databases, user media, logs, and personal tooling
# state must be structurally unable to enter the repository.
#
# Notes:
#  - .gitignore is prevention, NOT a guarantee: a file already committed
#    remains in Git history after deletion. See CONTRIBUTING.md and
#    docs/engineering/security-privacy.md for the remediation procedure.
#  - Image files are intentionally NOT blanket-ignored (the site needs
#    approved assets); scripts/privacy-scan.mjs enforces a LOCATION
#    ALLOWLIST for images instead.
# =====================================================================

# --- Secrets, credentials, private keys & certificates ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*
secrets/
.secrets/
*.secret
credentials*.json
tauri-keys/
*.sig
!**/test-fixtures/**/*.sig

# --- Environment-specific and personal configuration overrides ---
*.local
*.local.*
!*.local.example
config.local.*
tauri.local.conf.json
**/settings.local.json

# --- Local databases and application data ---
*.db
*.db-*
*.sqlite
*.sqlite3
gamescape.db*
local-data/
.dev-data/
user-data/

# --- User media and media types never stored in the repo ---
# (Full-resolution media lives on GitHub Releases/R2; published
#  derivatives are WebP/JPEG generated by the catalogue pipeline.)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.gif
library/
downloads/
imports/
personal/
captures/
screenshots/raw/

# --- Logs, crash dumps and diagnostics (may contain personal data) ---
*.log
logs/
*.dmp
*.trace
*.etl
diagnostics/
crash-reports/

# --- Build outputs and tooling caches ---
node_modules/
dist/
build/
out/
coverage/
.turbo/
.astro/
.vite/
target/
apps/desktop/src-tauri/target/
*.exe
*.msi
*.msix
*.appx
release-assets/
playwright-report/
test-results/
.cache/
.wrangler/
.vercel/
.temp/
tmp/
*.tmp
*.temp
# Exception: the committed catalogue index (reviewable data, not a build artifact)
!packages/catalogue/index/**

# --- Operating system metadata ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editors and IDE personal state ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
.fleet/
.zed/
*.code-workspace

# --- Private governance material (never public) ---
rights-register/
moderation-private/
legal-hold/
maintainer-notes/

# --- Misc ---
*.bak
*.orig
*.rej
*~
