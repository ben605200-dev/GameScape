{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameScape",
  "version": "0.5.0",
  "identifier": "app.gamescape.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameScape",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/GameScape/cache/**", "$PICTURE/GameScape Library/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GameScape",
    "copyright": "GameScape contributors - Apache-2.0",
    "category": "Utility",
    "shortDescription": "Desktop customisation: wallpapers, widgets and game-inspired setups.",
    "longDescription": "GameScape turns your Windows desktop into a personalised, game-inspired space. Apply static and animated wallpapers from your own library, pause automatically while you game, and more.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
