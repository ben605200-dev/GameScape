# =====================================================================
# GameScape environment template
# Copy to `.env` for local development and fill in values.
# NEVER commit real values. Never assume frontend values are secret.
#
# v1.0 desktop app and website require NO secrets.
# Everything below is reserved for the optional v1.2 backend and the
# release pipeline (those live in GitHub Actions secrets, not here).
# =====================================================================

# --- Optional: v1.2+ backend (not used yet) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: v1.2+ media hosting (Cloudflare R2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Release pipeline (GitHub Actions only — never in a local .env) ---
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
